# ============================================================
#  Kee V2C Platform — Application Properties Template
#  Copy this file to src/main/resources/application.properties
#  and fill in your own values.
# ============================================================

spring.application.name=V2C

# ────────────────────────────────────────────────────────────
#  Database — MySQL
#  Create the database manually before running the app.
#  Then execute the SQL scripts in src/main/resources/db/migration/
#  in the order listed in the README (foreign key dependencies apply).
# ────────────────────────────────────────────────────────────
spring.datasource.url=jdbc:mysql://localhost:3306/Kee_V2C_Platform
spring.datasource.username=YOUR_MYSQL_USERNAME
spring.datasource.password=YOUR_MYSQL_PASSWORD

# ────────────────────────────────────────────────────────────
#  JWT
#  secret-key must be a Base64-encoded string representing at
#  least 256 bits (32 bytes).
#  Generate one with: openssl rand -base64 32
#  expiration is in milliseconds (86400000 = 24 hours)
# ────────────────────────────────────────────────────────────
application.security.jwt.secret-key=YOUR_BASE64_JWT_SECRET_KEY
application.security.jwt.expiration=86400000

# ────────────────────────────────────────────────────────────
#  File Uploads
#  Absolute path to the directory where product/profile images
#  will be stored. The directory must exist and be writable.
#  Example (Windows): C:/uploads/v2c/
#  Example (Linux):   /var/uploads/v2c/
# ────────────────────────────────────────────────────────────
uploads_directory=YOUR_UPLOADS_DIRECTORY_PATH

v2c.upload.allowed-types=image/jpeg,image/png,image/gif,image/webp
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# ────────────────────────────────────────────────────────────
#  CORS
#  Origin(s) allowed to call the API (comma-separated).
#  For local development this is typically http://localhost:8080
# ────────────────────────────────────────────────────────────
app.cors.allowed-origins=http://localhost:8080

# ────────────────────────────────────────────────────────────
#  Swagger / OpenAPI UI
# ────────────────────────────────────────────────────────────
springdoc.swagger-ui.path=/swagger-ui.html

# ────────────────────────────────────────────────────────────
#  Logging (optional — tune as needed)
# ────────────────────────────────────────────────────────────
logging.level.org.hibernate.SQL=warn
logging.level.org.hibernate.orm.jdbc.bind=warn
logging.level.org.springframework.security=warn
